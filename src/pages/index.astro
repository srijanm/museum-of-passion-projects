---
import Base from '../layouts/Base.astro';
import Placard from '../components/Placard.astro';
import works from '../data/works.json';
---

<Base>
  <section class="section" aria-labelledby="permanent">
    <h2 class="section__head" id="permanent">Permanent Collection</h2>
    <div class="works">
      {works.map((work) => <Placard work={work} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="upcoming">
    <h2 class="section__head" id="upcoming">Upcoming Exhibitions</h2>
    <div class="works">
      <figure class="work">
        <div class="frame frame--empty" aria-hidden="true">
          <span class="frame__mat"><span class="frame__art"></span></span>
        </div>
        <figcaption class="placard">
          <p class="placard__line"><span class="placard__title">Forthcoming acquisition</span></p>
          <p class="placard__note">The Museum is in talks with the artists. Announcements to follow.</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="storage">
    <h2 class="section__head" id="storage">Storage</h2>
    <div class="works">
      <figure class="work">
        <div class="frame frame--empty" aria-hidden="true">
          <span class="frame__mat"><span class="frame__art"></span></span>
        </div>
        <figcaption class="placard">
          <p class="placard__line"><span class="placard__title">Vacant</span></p>
          <p class="placard__note">Nothing is currently in storage. The Museum expects this to change.</p>
        </figcaption>
      </figure>
    </div>
  </section>
</Base>
