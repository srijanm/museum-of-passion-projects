---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Museum of Passion Projects',
  description = 'A permanent collection of small works made for their own sake. Open 24 hours, admission free.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <a class="masthead__name" href="/">Museum of Passion Projects</a>
      <p class="masthead__sub">Permanent collection of small works made for their own sake</p>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="footer">
      <p>Open 24 hours · Admission free</p>
      <p>Museum of Passion Projects, est. 2025</p>
      <p><a href="/about">About the Museum</a></p>
    </footer>

    <style is:global>
      :root {
        --paper: #f1ede3;
        --mat: #fbfaf6;
        --moulding-light: #3a322a;
        --moulding-dark: #16110c;
        --ink: #201c16;
        --muted: #7c7263;
        --faint: #a39a89;
        --rule: #ddd6c8;
        --link: #4a3326;
        --serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
        --wall: 780px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--serif);
        font-size: 20px;
        line-height: 1.62;
        font-feature-settings: 'kern' 1, 'liga' 1;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--link);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }

      .content {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 0 32px;
      }

      /* ---- Masthead ---- */
      .masthead {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 96px 32px 0;
        text-align: center;
      }

      .masthead__name {
        display: inline-block;
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.9rem, 5.5vw, 3rem);
        line-height: 1.08;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
      }

      .masthead__sub {
        margin: 16px 0 0;
        font-family: var(--serif);
        font-style: italic;
        font-size: 1.02rem;
        color: var(--muted);
      }

      /* ---- Section signage (quiet wall text) ---- */
      .section {
        padding: 64px 0;
      }

      .section + .section {
        padding-top: 16px;
      }

      .section__head {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 56px;
        text-align: center;
      }

      .section__note {
        font-style: italic;
        font-size: 1.12rem;
        color: var(--muted);
        max-width: 42ch;
        margin: 0 auto;
        text-align: center;
      }

      /* ---- The wall: one work at a time ---- */
      .works {
        display: flex;
        flex-direction: column;
        gap: 112px;
      }

      .work {
        margin: 0;
      }

      /* ---- The frame (a link) ---- */
      .frame {
        position: relative;
        display: block;
        padding: 13px;
        background: linear-gradient(150deg, var(--moulding-light), var(--moulding-dark) 70%);
        border-radius: 2px;
        text-decoration: none;
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.35),
          0 1px 0 rgba(255, 255, 255, 0.05) inset,
          0 3px 4px -1px rgba(20, 14, 8, 0.28),
          0 30px 52px -26px rgba(20, 14, 8, 0.62);
        transition: box-shadow 0.3s ease, transform 0.3s ease;
      }

      .frame__mat {
        display: block;
        background: var(--mat);
        padding: 26px;
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.18) inset,
          0 0 0 1px rgba(0, 0, 0, 0.06);
      }

      .frame__art {
        position: relative;
        display: block;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #c7c2b6;
        box-shadow:
          inset 0 2px 8px rgba(0, 0, 0, 0.22),
          inset 0 0 0 1px rgba(0, 0, 0, 0.08);
      }

      .frame__art img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* ---- The one interactive touch (desktop hover only) ---- */
      .frame__notice {
        position: absolute;
        left: 50%;
        bottom: 30px;
        transform: translate(-50%, 10px);
        background: rgba(22, 17, 12, 0.92);
        color: #f1ede3;
        font-family: var(--mono);
        font-size: 0.62rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        padding: 8px 14px;
        border-radius: 2px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s ease, transform 0.28s ease;
      }

      @media (hover: hover) and (pointer: fine) {
        .frame:hover {
          box-shadow:
            0 0 0 1px rgba(0, 0, 0, 0.35),
            0 1px 0 rgba(255, 255, 255, 0.05) inset,
            0 4px 6px -1px rgba(20, 14, 8, 0.3),
            0 38px 60px -26px rgba(20, 14, 8, 0.66);
          transform: translateY(-2px);
        }

        .frame:hover .frame__notice {
          opacity: 1;
          transform: translate(-50%, 0);
        }
      }

      /* ---- The placard (wall label) ---- */
      .placard {
        margin: 26px 2px 0;
        max-width: 52ch;
      }

      .placard__line {
        margin: 0;
        font-size: 1.28rem;
        line-height: 1.25;
        color: var(--ink);
      }

      .placard__title {
        font-style: italic;
        font-weight: 500;
      }

      .placard__year {
        color: var(--muted);
      }

      .placard__medium {
        margin: 4px 0 0;
        font-size: 1.02rem;
        color: var(--ink);
      }

      .placard__meta {
        margin: 10px 0 0;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      .placard__note {
        margin: 14px 0 0;
        font-size: 1.02rem;
        color: #4a4339;
        max-width: 48ch;
      }

      /* ---- Colophon (about) ---- */
      .colophon {
        padding: 72px 0 24px;
        max-width: 52ch;
      }

      .colophon h1 {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 40px;
        text-align: center;
      }

      .colophon p {
        margin: 0 0 18px;
      }

      .colophon .admin {
        margin-top: 28px;
        font-family: var(--mono);
        font-size: 0.78rem;
        letter-spacing: 0.03em;
        color: var(--muted);
      }

      /* ---- Footer ---- */
      .footer {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 80px 32px 88px;
        text-align: center;
        font-family: var(--serif);
        font-size: 0.92rem;
        color: var(--muted);
      }

      .footer p {
        margin: 0 0 7px;
      }

      .footer a {
        color: var(--muted);
        font-style: italic;
      }

      .footer a:hover {
        color: var(--ink);
      }

      @media (max-width: 640px) {
        body {
          font-size: 19px;
        }
        .content {
          padding: 0 22px;
        }
        .masthead {
          padding: 64px 22px 0;
        }
        .section {
          padding: 48px 0;
        }
        .works {
          gap: 80px;
        }
        .section__head {
          margin-bottom: 40px;
        }
        .frame {
          padding: 10px;
        }
        .frame__mat {
          padding: 16px;
        }
        .frame__notice {
          display: none;
        }
        .footer {
          padding: 60px 22px 72px;
        }
      }
    </style>
  </body>
</html>
