---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Museum of Passion Projects',
  description = 'A permanent collection of small works made for their own sake. Open 24 hours, admission free.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <a class="masthead__name" href="/">Museum of Passion Projects</a>
      <p class="masthead__sub">Permanent collection of small works made for their own sake</p>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="footer">
      <p>Open 24 hours · Admission free</p>
      <p>Museum of Passion Projects, est. 2025</p>
      <p><a href="/about">About the Museum</a></p>
    </footer>

    <style is:global>
      :root {
        --paper: #f4f1e8;
        --paper-raised: #fbf9f3;
        --ink: #181612;
        --muted: #6f6657;
        --faint: #9a9082;
        --rule: #d9d2c4;
        --rule-strong: #c4bba9;
        --link: #5b3a2e;
        --serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--serif);
        font-size: 19px;
        line-height: 1.6;
        font-feature-settings: 'kern' 1, 'liga' 1;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--link);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }

      a:hover {
        text-decoration-thickness: 2px;
      }

      .content {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 28px;
      }

      /* ---- Masthead ---- */
      .masthead {
        max-width: 1080px;
        margin: 0 auto;
        padding: 64px 28px 40px;
        text-align: center;
        border-bottom: 1px solid var(--rule);
      }

      .masthead__name {
        display: inline-block;
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(2rem, 6vw, 3.6rem);
        line-height: 1.05;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
      }

      .masthead__name:hover {
        text-decoration: none;
        color: var(--link);
      }

      .masthead__sub {
        margin: 14px 0 0;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--muted);
      }

      /* ---- Section signage ---- */
      .section {
        padding: 56px 0;
        border-bottom: 1px solid var(--rule);
      }

      .section:last-of-type {
        border-bottom: 0;
      }

      .section__head {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.78rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 36px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--ink);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1em;
      }

      .section__head .count {
        color: var(--faint);
        font-size: 0.72rem;
        letter-spacing: 0.16em;
      }

      .section__note {
        font-size: 1.12rem;
        color: var(--muted);
        max-width: 46ch;
        margin: 0;
      }

      /* ---- Placards ---- */
      .placards {
        display: flex;
        flex-direction: column;
        gap: 64px;
      }

      .placard {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: 44px;
        align-items: start;
      }

      .placard__frame {
        margin: 0;
        background: var(--paper-raised);
        padding: 14px;
        border: 1px solid var(--rule-strong);
        box-shadow: 0 1px 0 #fff inset, 0 14px 30px -22px rgba(24, 22, 18, 0.5);
      }

      .placard__frame img {
        display: block;
        width: 100%;
        height: auto;
        border: 1px solid var(--rule);
      }

      .label {
        padding-top: 4px;
      }

      .label__title {
        font-size: 1.7rem;
        font-weight: 600;
        line-height: 1.15;
        margin: 0;
      }

      .label__year {
        font-weight: 400;
        font-style: italic;
        color: var(--muted);
      }

      .label__medium {
        margin: 6px 0 20px;
        font-style: italic;
        color: var(--ink);
        max-width: 40ch;
      }

      .meta {
        margin: 0 0 20px;
        border-top: 1px solid var(--rule);
      }

      .meta__row {
        display: grid;
        grid-template-columns: 8.5em 1fr;
        gap: 1em;
        padding: 8px 0;
        border-bottom: 1px solid var(--rule);
      }

      .meta__row dt {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: var(--muted);
        padding-top: 0.35em;
      }

      .meta__row dd {
        margin: 0;
      }

      .meta__row dd.mono {
        font-family: var(--mono);
        font-size: 0.85rem;
        letter-spacing: 0.04em;
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-family: var(--mono);
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
      }

      .status::before {
        content: '';
        width: 0.5em;
        height: 0.5em;
        border-radius: 50%;
        background: var(--faint);
      }

      .status--on-view::before {
        background: #3a7d44;
      }

      .status--upcoming::before {
        background: #b8860b;
      }

      .status--in-storage::before {
        background: #8a8170;
      }

      .label__note {
        margin: 0 0 22px;
        max-width: 44ch;
      }

      .label__link {
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
        border-bottom: 1px solid currentColor;
        padding-bottom: 2px;
      }

      .label__link:hover {
        text-decoration: none;
        color: var(--ink);
      }

      /* ---- Colophon (about) ---- */
      .colophon {
        padding: 56px 0 24px;
        max-width: 54ch;
      }

      .colophon h1 {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.78rem;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        margin: 0 0 32px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--ink);
      }

      .colophon p {
        margin: 0 0 18px;
      }

      .colophon .admin {
        font-family: var(--mono);
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        color: var(--muted);
      }

      /* ---- Footer ---- */
      .footer {
        max-width: 1080px;
        margin: 0 auto;
        padding: 48px 28px 72px;
        border-top: 1px solid var(--rule);
        text-align: center;
        font-family: var(--mono);
        font-size: 0.74rem;
        letter-spacing: 0.1em;
        color: var(--muted);
      }

      .footer p {
        margin: 0 0 8px;
      }

      .footer a {
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.14em;
      }

      .footer a:hover {
        color: var(--ink);
      }

      @media (max-width: 720px) {
        body {
          font-size: 18px;
        }
        .placard {
          grid-template-columns: 1fr;
          gap: 22px;
        }
        .section {
          padding: 44px 0;
        }
        .placards {
          gap: 52px;
        }
      }
    </style>
  </body>
</html>
