---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Museum of Passion Projects',
  description = 'A permanent collection of small works made for their own sake. Open 24 hours, admission free.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Libre+Franklin:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <header class="masthead">
      <a class="masthead__name" href="/">Museum of Passion Projects</a>
      <p class="masthead__sub">Permanent collection of small works made for their own sake</p>
    </header>

    <main class="content">
      <slot />
    </main>

    <footer class="footer">
      <p>Open 24 hours · Admission free</p>
      <p>Museum of Passion Projects, est. 2026</p>
      <p><a href="/about">About the Museum</a></p>
    </footer>

    <style is:global>
      :root {
        --paper: #ffffff; /* white cube gallery wall */
        --mat: #ffffff; /* white mat; separated from the wall by a hairline + shadow */
        --moulding-light: #3a322a;
        --moulding-dark: #16110c;
        --ink: #141414; /* near-black, neutral */
        --muted: #777777; /* neutral gray metadata */
        --faint: #9a9a9a;
        --rule: #e6e6e6;
        --link: #2a2a2a;
        --note: #1c1c1c;
        --serif: 'EB Garamond', Georgia, 'Times New Roman', serif;
        --sans: 'Libre Franklin', system-ui, -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif;
        --wall: 1200px;
        --ease: cubic-bezier(0.22, 1, 0.36, 1); /* ease-out, no overshoot */
      }

      * {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--serif);
        font-size: 20px;
        line-height: 1.62;
        font-feature-settings: 'kern' 1, 'liga' 1;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--link);
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
      }

      .content {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 0 32px;
      }

      /* ---- Masthead ---- */
      .masthead {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 96px 32px 0;
        text-align: center;
      }

      .masthead__name {
        display: inline-block;
        font-family: var(--serif);
        font-weight: 500;
        font-size: clamp(1.9rem, 5.5vw, 3rem);
        line-height: 1.08;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
      }

      .masthead__sub {
        margin: 18px 0 0;
        font-family: var(--sans);
        font-size: 0.78rem;
        font-weight: 400;
        letter-spacing: 0.1em;
        color: var(--muted);
      }

      /* ---- Section signage (quiet wall text, left-aligned to grid) ---- */
      .section {
        padding: 60px 0;
      }

      .section + .section {
        padding-top: 12px;
      }

      .section__head {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 32px;
        text-align: left;
      }

      /* ---- The wall: works hung left to right ---- */
      .works {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 64px 40px;
        align-items: start; /* placards top-align across a row */
      }

      .work {
        margin: 0;
        display: flex;
        flex-direction: column;
      }

      /* ---- The frame ---- */
      .frame {
        position: relative;
        display: block;
        padding: 12px;
        background: linear-gradient(150deg, var(--moulding-light), var(--moulding-dark) 70%);
        border-radius: 2px;
        text-decoration: none;
        box-shadow:
          0 0 0 1px rgba(0, 0, 0, 0.4),
          0 1px 0 rgba(255, 255, 255, 0.05) inset,
          0 3px 4px -1px rgba(0, 0, 0, 0.22),
          0 26px 46px -24px rgba(0, 0, 0, 0.45);
        transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease);
        transform: scale(1);
        will-change: transform;
      }

      .frame__mat {
        display: block;
        background: var(--mat);
        padding: 22px;
        /* hairline + faint inner shadow so the white mat stays distinct
           from the white wall and reads as a recessed mat board */
        box-shadow:
          inset 0 0 0 1px rgba(0, 0, 0, 0.09),
          inset 0 2px 6px rgba(0, 0, 0, 0.06);
      }

      .frame__art {
        position: relative;
        display: block;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        background: #ededed;
        box-shadow:
          inset 0 2px 8px rgba(0, 0, 0, 0.22),
          inset 0 0 0 1px rgba(0, 0, 0, 0.08);
      }

      .frame__art img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      /* ---- Empty frame (Upcoming / Storage): bare wall inside the mat ---- */
      .frame--empty {
        cursor: default;
      }

      .frame--empty .frame__art {
        background: var(--paper);
        box-shadow:
          inset 0 1px 4px rgba(0, 0, 0, 0.1),
          inset 0 0 0 1px rgba(0, 0, 0, 0.05);
      }

      /* ---- The one interactive touch (desktop hover, real works only) ---- */
      .frame__notice {
        position: absolute;
        left: 50%;
        bottom: 28px;
        transform: translate(-50%, 10px);
        background: rgba(17, 17, 17, 0.92);
        color: #ffffff;
        font-family: var(--sans);
        font-size: 0.62rem;
        font-weight: 400;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 8px 14px;
        border-radius: 2px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, 4px); /* 4px rise on reveal */
        transition: opacity 0.2s var(--ease), transform 0.2s var(--ease);
      }

      @media (hover: hover) and (pointer: fine) {
        /* Hover lift: lean in toward the work (real frames only) */
        a.frame:hover {
          box-shadow:
            0 0 0 1px rgba(0, 0, 0, 0.4),
            0 1px 0 rgba(255, 255, 255, 0.05) inset,
            0 6px 10px -2px rgba(0, 0, 0, 0.28),
            0 40px 64px -24px rgba(0, 0, 0, 0.55);
          transform: scale(1.01);
        }

        a.frame:hover .frame__notice {
          opacity: 1;
          transform: translate(-50%, 0);
        }
      }

      /* Press feedback: almost subliminal dip (mouse + touch via pointer JS).
         Placed after :hover so it wins when pressing a hovered frame. */
      a.frame.is-pressed {
        transform: scale(0.995);
        transition: transform 0.1s var(--ease);
      }

      /* ---- The placard (wall label) ---- */
      .placard {
        margin: 22px 0 0;
      }

      .placard__line {
        margin: 0;
        font-family: var(--serif);
        font-size: 1.24rem;
        line-height: 1.25;
        color: var(--ink);
      }

      .placard__title {
        font-style: italic;
        font-weight: 500;
      }

      .placard__year {
        color: var(--faint);
      }

      .placard__medium {
        margin: 8px 0 0;
        font-family: var(--sans);
        font-size: 0.78rem;
        line-height: 1.5;
        letter-spacing: 0.03em;
        color: var(--muted);
      }

      .placard__meta {
        margin: 7px 0 0;
        font-family: var(--sans);
        font-size: 0.74rem;
        line-height: 1.5;
        letter-spacing: 0.045em;
        color: var(--muted);
      }

      .placard__credit--owned {
        font-style: italic;
        letter-spacing: 0.02em;
        color: var(--ink);
        border-bottom: 1px solid var(--faint);
      }

      .placard__note {
        margin: 14px 0 0;
        font-family: var(--serif);
        font-size: 1.02rem;
        line-height: 1.5;
        color: var(--note);
      }

      /* ---- Colophon (about) ---- */
      .colophon {
        padding: 72px 0 24px;
        max-width: 52ch;
      }

      .colophon h1 {
        font-family: var(--serif);
        font-weight: 500;
        font-size: 0.82rem;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 40px;
        text-align: left;
      }

      .colophon p {
        margin: 0 0 18px;
        font-family: var(--serif);
      }

      .colophon .admin {
        margin-top: 28px;
        font-family: var(--sans);
        font-size: 0.76rem;
        letter-spacing: 0.045em;
        color: var(--muted);
      }

      /* ---- Footer ---- */
      .footer {
        max-width: var(--wall);
        margin: 0 auto;
        padding: 88px 32px 88px;
        text-align: center;
        font-family: var(--sans);
        font-size: 0.76rem;
        letter-spacing: 0.08em;
        color: var(--muted);
      }

      .footer p {
        margin: 0 0 8px;
      }

      .footer a {
        color: var(--muted);
        text-decoration-thickness: 1px;
      }

      .footer a:hover {
        color: var(--ink);
      }

      /* ---- Too narrow for three: drop to two ---- */
      @media (max-width: 1024px) {
        .works {
          grid-template-columns: repeat(2, 1fr);
          gap: 56px 36px;
        }
      }

      /* ---- Mobile corridor: single column (stays as before) ---- */
      @media (max-width: 768px) {
        body {
          font-size: 19px;
        }
        .content {
          padding: 0 22px;
        }
        .masthead {
          padding: 64px 22px 0;
        }
        .section {
          padding: 48px 0;
        }
        .section__head {
          margin-bottom: 36px;
        }
        .works {
          grid-template-columns: 1fr;
          gap: 80px;
        }
        .frame {
          padding: 10px;
        }
        .frame__mat {
          padding: 16px;
        }
        .frame__notice {
          display: none;
        }
        .footer {
          padding: 60px 22px 72px;
        }
      }

      /* ---- Scroll reveal (only when motion is allowed) ---- */
      @media (prefers-reduced-motion: no-preference) {
        /* Hidden state is applied by JS (is-pre) only once the observer is
           live, so content is visible by default if JS never runs. */
        .reveal.is-pre {
          opacity: 0;
          transform: translateY(12px);
        }
        .reveal.is-in {
          opacity: 1;
          transform: none;
          transition:
            opacity 0.6s var(--ease),
            transform 0.6s var(--ease);
          transition-delay: var(--reveal-delay, 0ms);
        }

        /* ---- Page crossfade via View Transitions (~300ms) ---- */
        ::view-transition-old(root) {
          animation: vt-fade-out 0.3s var(--ease) both;
        }
        ::view-transition-new(root) {
          animation: vt-fade-in 0.3s var(--ease) both;
        }
        @keyframes vt-fade-out {
          to {
            opacity: 0;
          }
        }
        @keyframes vt-fade-in {
          from {
            opacity: 0;
          }
        }
      }

      /* ---- Reduced motion: everything simply appears, no transforms ---- */
      @media (prefers-reduced-motion: reduce) {
        .reveal,
        .reveal.is-pre,
        .reveal.is-in {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
        .frame,
        a.frame:hover,
        a.frame.is-pressed {
          transform: none !important;
          transition: none !important;
        }
        .frame__notice {
          transform: translate(-50%, 0) !important;
          transition: none !important;
        }
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none !important;
        }
      }
    </style>

    <script>
      // Quiet-gallery motion: scroll reveal (stagger), press feedback.
      // Progressive enhancement — content is visible unless this runs.
      function initMotion() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Press feedback on real (linked) frames only — mouse + touch.
        document.querySelectorAll('a.frame').forEach((frame) => {
          if (frame.dataset.pressBound) return;
          frame.dataset.pressBound = '1';
          const press = () => frame.classList.add('is-pressed');
          const release = () => frame.classList.remove('is-pressed');
          frame.addEventListener('pointerdown', press);
          frame.addEventListener('pointerup', release);
          frame.addEventListener('pointerleave', release);
          frame.addEventListener('pointercancel', release);
        });

        const reveals = document.querySelectorAll('.reveal');
        if (reduce || !('IntersectionObserver' in window) || !reveals.length) {
          return; // leave everything visible
        }

        // Hide now that we know we can reveal.
        reveals.forEach((el) => el.classList.add('is-pre'));

        const show = (el, delay) => {
          el.style.setProperty('--reveal-delay', delay + 'ms');
          el.classList.remove('is-pre');
          el.classList.add('is-in');
        };

        const io = new IntersectionObserver(
          (entries, obs) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            visible.forEach((entry, i) => {
              const base = i * 120; // gentle stagger between works in a flush
              const group = entry.target;
              obs.unobserve(group);
              if (group.matches('.section__head')) {
                show(group, base);
              } else {
                const frame = group.querySelector('[data-reveal="frame"]');
                const placard = group.querySelector('[data-reveal="placard"]');
                if (frame) show(frame, base);
                if (placard) show(placard, base + 150); // placard follows frame
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );

        document.querySelectorAll('[data-reveal-group]').forEach((g) => io.observe(g));
      }

      // Runs on first load and after every View Transitions navigation.
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
