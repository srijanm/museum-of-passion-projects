---
interface Work {
  title: string;
  year: string;
  medium: string;
  accession: string;
  credit: string;
  status: string;
  url: string;
  image: string;
  note: string;
}

const { work } = Astro.props as { work: Work };
---

<figure class="work">
  <a class="frame" href={work.url} target="_blank" rel="noopener noreferrer" aria-label={`${work.title} — open in a new tab`}>
    <span class="frame__mat">
      <span class="frame__art">
        <img src={work.image} alt={`${work.title}, ${work.year}`} width="1280" height="800" loading="lazy" />
      </span>
    </span>
    <span class="frame__notice" aria-hidden="true">please do not touch the exhibits</span>
  </a>

  <figcaption class="placard">
    <p class="placard__line">
      <span class="placard__title">{work.title}</span><span class="placard__year">, {work.year}</span>
    </p>
    <p class="placard__medium">{work.medium}</p>
    <p class="placard__meta">{work.accession} · {work.credit}</p>
    <p class="placard__note">{work.note}</p>
  </figcaption>
</figure>
